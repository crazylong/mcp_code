          },
          {
            "path": "src/Http.java",
            "line": 3,
            "snippet": "void send() { log(\"timeout\"); }"
          }
        ],
        "total": 2,
        "truncated": false,
        "next_cursor": null,
        "ok": true
      },
      "isError": false,
      "resultType": "complete"
    }
  }
}
