# 复制成同目录的 .env 再填自己的密钥：cp mcp_code/.env.sample mcp_code/.env
# mcp_code/.env 已被 .gitignore 忽略，不会被提交。

# 模型名必须带供应商前缀，格式是 "供应商:模型名"。
# 走任何 OpenAI 兼容接口时都写 openai:，真实地址由 OPENAI_BASE_URL 决定。
MCP_MODEL=openai:glm-5.3

# OpenAI 兼容接口的密钥与地址
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ---- 常见组合 ----
#
# 阿里云百炼（DashScope 兼容模式）
#   pip install langchain-openai
#   MCP_MODEL=openai:glm-5.3
#   OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#
# OpenAI 官方
#   pip install langchain-openai
#   MCP_MODEL=openai:gpt-4.1
#   OPENAI_BASE_URL=https://api.openai.com/v1
#
# 本地 Ollama（不需要 key）
#   pip install langchain-ollama
#   MCP_MODEL=ollama:qwen3
#
# 提示：写成不带前缀的 MCP_MODEL=glm-5.3 会报
# "Unable to infer model provider"，供应商必须显式指定。
#
# ---- 可选 ----
# 存量接口的调用超时（秒），默认 3
# LEGACY_TIMEOUT=3
# 认证示例 Server 的端口，默认 8765
# MCP_PORT=8765
